# Copy to .env.production with deploy/generate-env.sh. Never commit that file.
POSTGRES_DB=quality_platform
POSTGRES_USER=qp_user
POSTGRES_PASSWORD=GENERATED_BY_SETUP
SECRET_KEY=GENERATED_BY_SETUP

ENVIRONMENT=production
DEBUG=false
APP_NAME=Quality Intelligence Platform
APP_VERSION=1.0.0
API_DOCS_ENABLED=false
BACKEND_WORKERS=2

# Use the server's fixed LAN IP or internal DNS name.
APP_URL=http://quality-app
CORS_ORIGINS=http://quality-app
TRUSTED_HOSTS=quality-app,localhost,127.0.0.1
APP_BIND_IP=0.0.0.0
HTTP_PORT=80

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# Optional Azure Document Intelligence
AZURE_DI_ENDPOINT=
AZURE_DI_API_KEY=
