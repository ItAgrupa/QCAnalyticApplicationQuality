# ============================================================
# Quality Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=quality_platform
POSTGRES_USER=qp_user
POSTGRES_PASSWORD=change_me_strong_password

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Backend / FastAPI ----
SECRET_KEY=change_me_very_long_random_secret_key_at_least_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- File Storage ----
UPLOAD_DIR=/app/storage/uploads

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Celery ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Azure Document Intelligence (optional / future) ----
AZURE_DI_ENDPOINT=
AZURE_DI_API_KEY=

# ---- App metadata ----
APP_NAME=Quality Intelligence Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
